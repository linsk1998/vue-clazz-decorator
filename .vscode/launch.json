{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Vitest: Current File",
			"type": "node",
			"request": "launch",
			"runtimeArgs": [
				"${workspaceFolder}/node_modules/vitest/vitest.mjs",
				"${file}",
				"-c",
				"vitest.babel-proposal.config.js",
				"--watch=false",
				"--test-timeout=0"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": [
				"<node_internals>/**"
			]
		}
	]
}
