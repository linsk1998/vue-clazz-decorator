{
	"name": "vue-clazz-decorator",
	"version": "0.0.0",
	"description": "Write Vue 3 components with Class + Decorators, featuring MVVM pattern, metadata system, and reactive model layer.",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"types"
	],
	"keywords": [],
	"author": "linsk",
	"license": "MIT",
	"scripts": {
		"build": "rollup -c rollup.config.mjs",
		"types": "tsc --declaration --declarationDir types",
		"test": "npm run test:experimental && npm run test:proposal && npm run test:babel-experimental && npm run test:babel-proposal && npm run test:metadata-experimental && npm run test:metadata-babel-experimental",
		"test:experimental": "vitest -c tests/vitest.experimental.config.js --watch=false",
		"test:proposal": "vitest -c tests/vitest.proposal.config.js --watch=false",
		"test:babel-experimental": "vitest -c tests/vitest.babel-experimental.config.js --watch=false",
		"test:babel-proposal": "vitest -c tests/vitest.babel-proposal.config.js --watch=false",
		"test:metadata-experimental": "vitest -c tests/vitest.metadata-experimental.config.js --watch=false",
		"test:metadata-babel-experimental": "vitest -c tests/vitest.metadata-babel-experimental.config.js --watch=false"
	},
	"dependencies": {
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@babel/core": "^7.27.4",
		"@babel/plugin-proposal-decorators": "7.27.1",
		"@babel/plugin-transform-runtime": "^7.25.9",
		"@babel/plugin-transform-typescript": "^7.26.7",
		"@babel/runtime": "^7.26.7",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-inject": "^5.0.5",
		"@rollup/plugin-typescript": "^12.1.2",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitejs/plugin-vue-jsx": "^5.1.5",
		"@vitest/ui": "3.0.4",
		"@vue/babel-plugin-jsx": "^1.2.5",
		"@vue/test-utils": "^2.4.6",
		"babel-plugin-mark-fields": "^1.0.0",
		"babel-plugin-transform-typescript-decorators": "^0.3.0",
		"babel-plugin-transform-typescript-metadata": "^0.4.0",
		"jsdom": "^26.0.0",
		"rollup": "3.0.0",
		"sky-core": "^0.24.0",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"typescript-plugin-mark-fields": "^1.0.0",
		"vite": "^6.0.11",
		"vitest": "^3.0.4"
	}
}
