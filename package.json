{
	"name": "vue-clazz-decorator",
	"version": "0.1.0",
	"description": "Write Vue 3 components with Class + Decorators, featuring ViewModel/View separation, metadata system, and reactive model layer.",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"types"
	],
	"keywords": [
		"vue",
		"vue3",
		"class",
		"decorator",
		"clazz",
		"viewmodel",
		"reactive",
		"model",
		"hydrate",
		"serialize",
		"metadata",
		"typescript"
	],
	"author": "linsk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/linsk1998/vue-clazz-decorator.git"
	},
	"bugs": {
		"url": "https://github.com/linsk1998/vue-clazz-decorator/issues"
	},
	"homepage": "https://github.com/linsk1998/vue-clazz-decorator#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "rollup -c",
		"types": "tsc -p tsconfig.types.json",
		"test": "npm run test:proposal && npm run test:proposal:babel && npm run test:experimental && npm run test:experimental:babel && npm run test:metadata && npm run test:metadata:babel",
		"test:proposal": "vitest -c tests/vitest.config.js --watch=false",
		"test:proposal:babel": "vitest -c tests/vitest.config.js --mode babel --watch=false",
		"test:experimental": "vitest -c tests/vitest.experimental.config.js --watch=false",
		"test:experimental:babel": "vitest -c tests/vitest.experimental.config.js --mode babel --watch=false",
		"test:metadata": "vitest -c tests/vitest.metadata-experimental.config.js --watch=false",
		"test:metadata:babel": "vitest -c tests/vitest.metadata-experimental.config.js --mode babel --watch=false",
		"prepublishOnly": "npm run clean && npm run build && npm run types && npm test",
		"clean": "npx rimraf dist types"
	},
	"dependencies": {
		"@babel/runtime": "^7.26.7",
		"java.text.simple-date-format": "^1.0.0",
		"tslib": "^2.8.1"
	},
	"peerDependencies": {
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@babel/core": "^7.27.4",
		"@babel/plugin-proposal-decorators": "7.27.1",
		"@babel/plugin-transform-runtime": "^7.25.9",
		"@babel/plugin-transform-typescript": "^7.26.7",
		"@rollup/plugin-alias": "^5.0.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-inject": "^5.0.5",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.1.2",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitejs/plugin-vue-jsx": "^5.1.5",
		"@vitest/ui": "3.0.4",
		"@vue/babel-plugin-jsx": "^1.2.5",
		"@vue/test-utils": "^2.4.6",
		"babel-plugin-mark-fields": "^1.0.0",
		"babel-plugin-transform-typescript-decorators": "^0.3.0",
		"babel-plugin-transform-typescript-metadata": "^0.4.0",
		"jsdom": "^26.0.0",
		"rollup": "3.0.0",
		"sky-core": "^0.24.0",
		"typescript": "5.9.3",
		"typescript-plugin-mark-fields": "^1.0.0",
		"vite": "^6.0.11",
		"vitest": "^3.0.4"
	}
}
